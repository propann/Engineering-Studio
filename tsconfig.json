{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "baseUrl": ".",
    "paths": {
      "@studio-hub/midi-bridge": ["./packages/midi-bridge/index.ts"],
      "@studio-hub/audio-bridge": ["./packages/audio-bridge/index.ts"],
      "@studio-hub/core/*": ["./apps/studio-hub/src/core/*"]
    }
  },
  "include": ["apps/studio-hub/src/**/*", "packages/**/*"],
  "exclude": ["archive", "**/archive/**", "node_modules", "dist"]
}
