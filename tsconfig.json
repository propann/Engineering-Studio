{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    // Le verrou qui aurait signale les quatre pages mortes du hub des le
    // premier jour. Il reste a `false` pour une seule raison : `studio-hub` et
    // `packages/` sont propres, mais `tsc` suit les imports vers
    // `apps/op1-studio` et `apps/ep133-studio`, qui portent 43 declarations
    // inutilisees. A rebasculer des que ce lot est traite.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "baseUrl": ".",
    "paths": {
      "@studio-hub/midi-bridge": ["./packages/midi-bridge/index.ts"],
      "@studio-hub/audio-bridge": ["./packages/audio-bridge/index.ts"],
      "@studio-hub/fs-handles": ["./packages/fs-handles/index.ts"],
      "@studio-hub/audio-formats": ["./packages/audio-formats/index.ts"],
      "@studio-hub/midi-dispatch": ["./packages/midi-dispatch/index.ts"],
      "@studio-hub/musique": ["./packages/musique/index.ts"],
      "@studio-hub/music-git": ["./packages/music-git/index.ts"],
      "@studio-hub/p2p-collab": ["./packages/p2p-collab/index.ts"],
      "@studio-hub/rack-bus": ["./packages/rack-bus/index.ts"],
      "@studio-hub/core/*": ["./apps/studio-hub/src/core/*"]
    }
  },
  "include": ["apps/studio-hub/src/**/*", "packages/**/*"],
  "exclude": ["archive", "**/archive/**", "node_modules", "dist"]
}
