{
  "name": "studio-hub",
  "version": "1.0.0",
  "description": "Studio Hub - Monorepo for OP-1 Studio + EP-133 Studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "install:all": "npm ci",
    "build:all": "npm run build -w apps/studio-hub && npm run build -w apps/op1-studio && npm run build -w apps/ep133-studio",
    "test:all": "npm run test -ws --if-present -- --run",
    "lint:all": "npm run lint -w apps/op1-studio",
    "typecheck:all": "npm run typecheck -ws --if-present",
    "dev:hub": "npm run dev -w apps/studio-hub",
    "dev:op1": "npm run dev -w apps/op1-studio",
    "dev:ep133": "npm run dev -w apps/ep133-studio",
    "dev:both": "npm run dev -ws",
    "clean": "find . -name node_modules -type d -exec rm -rf {} + 2>/dev/null || true"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15",
    "typescript": "5.9.3"
  },
  "devDependencies": {}
}
